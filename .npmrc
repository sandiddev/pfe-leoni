# Fail loudly on unmet peer dependencies instead of silently producing a broken tree.
strict-peer-dependencies=true

# Only packages declared in a package.json are importable from it.
# This is what makes the architecture's dependency rule physically true and not
# merely a lint convention: @leoni/ui cannot import @leoni/db if it never declared it.
resolution-mode=highest
auto-install-peers=false
dedupe-peer-dependents=true

# Workspace packages always resolve to the local source, never to the registry.
link-workspace-packages=true
prefer-workspace-packages=true
save-workspace-protocol=rolling

# Reproducible installs.
engine-strict=true

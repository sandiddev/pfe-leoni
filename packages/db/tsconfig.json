{
  "extends": "@leoni/tsconfig/library.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma.config.ts", "vitest.config.ts", "eslint.config.js"],
  // `src/generated` is not excluded: client.ts imports it, so TypeScript pulls
  // it in regardless and an exclude here only reads as a rule that is not one.
  // ESLint is where the generated client is actually skipped (eslint.config.js).
  "exclude": ["node_modules"]
}

// ---------------------------------------------------------------------------
// Replenishment parameters and their history.
//
// This file is the reason section 3.4 of the brief is satisfied: every number
// the logistics team might want to tune is a row here, never a constant in
// TypeScript. Changing the safety margin for class A is a form submission, not
// a redeployment.
// ---------------------------------------------------------------------------

/// Tuning parameters, scoped either to an ABC class or to a single article.
///
/// Exactly one of `abcClass` / `articleId` is set. An article-level row
/// overrides its class defaults, which is how a single critical reference can
/// be treated more conservatively than the rest of its class.
model ReplenishmentParameter {
  id String @id @default(cuid())

  /// Set for a class-level default. Null on an article override.
  abcClass AbcClass? @unique

  /// Set for an article-level override. Null on a class default.
  articleId String?  @unique
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Margin against consumption variability, in days of consumption.
  /// Per-class defaults live in `DEFAULT_CLASS_PARAMETERS` (@leoni/core) — the
  /// single source of truth. The column default below only applies to an INSERT
  /// that omits the field, which no code path does; `parameter-parity.test.ts`
  /// keeps it from drifting into a value no class uses.
  safetyDays Decimal @default(1) @db.Decimal(6, 2)

  /// Coverage restored on top of the minimum.
  /// See `DEFAULT_CLASS_PARAMETERS` in @leoni/core for the per-class values.
  extraCoverageDays Decimal @default(5) @db.Decimal(6, 2)

  /// Window for the rolling consumption average: 7, 30 or 90 days.
  /// `AVERAGING_WINDOWS` in @leoni/core is the permitted set.
  averagingWindowDays Int @default(30)

  /// How far above Min the early warning fires, as a fraction of Min.
  /// Mirrors `DEFAULT_WARNING_MARGIN_RATIO` in @leoni/core.
  warningMarginRatio Decimal @default(0.2) @db.Decimal(4, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("replenishment_parameter")
}

/// One row per recomputation, per stock item.
///
/// Section 3.5 requires that a threshold change can be explained afterwards.
/// The parameters in force at the time are snapshotted as JSON rather than
/// referenced, because the parameter row they came from will itself change: a
/// foreign key would make the history lie the moment someone edits a default.
model ThresholdHistory {
  id String @id @default(cuid())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  averageDailyConsumption Decimal @db.Decimal(12, 3)
  minThreshold            Decimal @db.Decimal(12, 3)
  maxThreshold            Decimal @db.Decimal(12, 3)
  safetyStock             Decimal @db.Decimal(12, 3)

  /// The exact inputs used, frozen at computation time.
  parametersSnapshot Json

  trigger    RecalculationTrigger
  computedAt DateTime             @default(now())

  /// Null for the nightly job.
  computedById String?

  @@index([stockItemId, computedAt])
  @@map("threshold_history")
}

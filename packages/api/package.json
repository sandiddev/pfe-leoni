    "@leoni/env": "workspace:*",
    "@trpc/server": "catalog:",
    "papaparse": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@leoni/eslint-config": "workspace:*",
    "@leoni/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/papaparse": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }

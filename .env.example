# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored; this file is the contract.
# Every variable here is validated at boot by `@leoni/env` — an app will refuse
# to start rather than run with a missing or malformed value.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://leoni:leoni@localhost:5432/leoni_replenishment?schema=public"

# Separate database on the same container, used by integration tests.
# Truncated between test files — never point this at the dev database.
TEST_DATABASE_URL="postgresql://leoni:leoni@localhost:5432/leoni_replenishment_test?schema=public"

# --- Authentication ---------------------------------------------------------
# Generate a fresh one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:4300"

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:4300"

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret required by POST /api/jobs/recalculate, called by the host
# scheduler to recompute Min/Max thresholds daily (brief section 3.5).
JOB_SECRET="replace-me-with-another-random-string"

# --- Seed -------------------------------------------------------------------
# Password given to every demo user created by `pnpm db:seed`.
SEED_USER_PASSWORD="Leoni2026!"

# Where request attachments are written. Any directory the process can write to.
UPLOAD_DIR="./uploads"

{
  "extends": "@leoni/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": { "~/*": ["./src/*"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    "eslint.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}

{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-file.sh\"",
            "timeout": 120,
            "statusMessage": "Linting the edited file"
          }
        ]
      }
    ]
  }
}

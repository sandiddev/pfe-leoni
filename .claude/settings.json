{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-applied-migrations.sh\"",
            "timeout": 20,
            "statusMessage": "Checking migration history"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-file.sh\"",
            "timeout": 120,
            "statusMessage": "Linting the edited file"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/prisma-guard.sh\"",
            "timeout": 120,
            "statusMessage": "Validating the Prisma schema"
          }
        ]
      }
    ]
  }
}
